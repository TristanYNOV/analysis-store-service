              "raw": "{\n  \"schemaVersion\": \"1.0.0\",\n  \"type\": \"analysis-timeline\",\n  \"timelineName\": \"Match Timeline\",\n  \"meta\": {\n    \"createdAtIso\": \"2026-04-04T08:00:00Z\",\n    \"updatedAtIso\": \"2026-04-04T08:30:00Z\",\n    \"exportedAtIso\": \"2026-04-04T09:00:00+00:00\",\n    \"sourceUserId\": \"user-42\",\n    \"sourceApp\": \"analysis-store-service\",\n    \"sourceAppVersion\": \"1.0.0\"\n  },\n  \"eventDefs\": [\n    {\n      \"id\": \"evt-goal\",\n      \"name\": \"Goal\",\n      \"colorHex\": \"#00FFAA\"\n    },\n    {\n      \"id\": \"evt-foul\",\n      \"name\": \"Foul\",\n      \"colorHex\": \"#AA3344\"\n    }\n  ],\n  \"labelDefs\": [\n    {\n      \"id\": \"lbl-build-up\",\n      \"name\": \"Build-up\",\n      \"colorHex\": \"#112233\"\n    }\n  ],\n  \"occurrences\": [\n    {\n      \"id\": \"occ-1\",\n      \"eventDefId\": \"evt-goal\",\n      \"labelDefId\": null,\n      \"occurredAtIso\": \"2026-04-04T08:10:00+00:00\",\n      \"durationMs\": 3200,\n      \"note\": \"Goal on counter attack\"\n    },\n    {\n      \"id\": \"occ-2\",\n      \"eventDefId\": null,\n      \"labelDefId\": \"lbl-build-up\",\n      \"occurredAtIso\": \"2026-04-04T08:12:00+00:00\",\n      \"durationMs\": 1800,\n      \"note\": null\n    }\n  ],\n  \"ui\": {\n    \"zoom\": 1.25,\n    \"showLabels\": true,\n    \"selectedOccurrenceId\": \"occ-1\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/imports/timelines/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imports",
                "timelines",
                "validate"
              ]
            },
            "description": "Payload synchronisé avec postman/examples/analysis-timeline.valid.v1.json"
          }
