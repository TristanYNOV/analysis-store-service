                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Panel joueurs anonymisé\",\n  \"description\": \"Données métier sensibles sur des joueurs, IDs techniques non sensibles\",\n  \"visibility\": \"public\",\n  \"contentJson\": {\n    \"schemaVersion\": \"1.0.0\",\n    \"type\": \"sequencer-panel\",\n    \"panelName\": \"Panel joueurs - anonymisation\",\n    \"meta\": {\n      \"createdAtIso\": \"2026-04-11T09:00:00Z\",\n      \"updatedAtIso\": \"2026-04-11T09:30:00Z\",\n      \"exportedAtIso\": \"2026-04-11T10:00:00Z\",\n      \"sourceUserId\": null,\n      \"sourceApp\": \"analysis-store-service\",\n      \"sourceAppVersion\": \"1.0.0\"\n    },\n    \"btnList\": [\n      {\n        \"id\": \"btn-player-01\",\n        \"name\": \"Joueur titulaire A\",\n        \"type\": \"event\",\n        \"isAnonymized\": true,\n        \"eventProps\": {\n          \"eventName\": \"Passe clé - Alex Martin\",\n          \"colorHex\": \"#E63946\"\n        },\n        \"layout\": {\n          \"x\": 0,\n          \"y\": 0,\n          \"w\": 2,\n          \"h\": 1,\n          \"z\": 0\n        },\n        \"hotkeyNormalized\": null,\n        \"deactivateIds\": [],\n        \"activateIds\": [\n          \"btn-label-01\"\n        ]\n      },\n      {\n        \"id\": \"btn-label-01\",\n        \"name\": \"Profil joueur\",\n        \"type\": \"label\",\n        \"anonymized\": true,\n        \"labelProps\": {\n          \"label\": \"Nom complet: Alex Martin\",\n          \"colorHex\": \"#457B9D\"\n        },\n        \"layout\": {\n          \"x\": 2,\n          \"y\": 0,\n          \"w\": 2,\n          \"h\": 1,\n          \"z\": 1\n        },\n        \"hotkeyNormalized\": null,\n        \"deactivateIds\": [],\n        \"activateIds\": []\n      },\n      {\n        \"id\": \"btn-tech-01\",\n        \"name\": \"Segment tactique\",\n        \"type\": \"event\",\n        \"eventProps\": {\n          \"eventName\": \"Pressing haut\",\n          \"colorHex\": \"#2A9D8F\"\n        },\n        \"layout\": {\n          \"x\": 4,\n          \"y\": 0,\n          \"w\": 2,\n          \"h\": 1,\n          \"z\": 2\n        },\n        \"hotkeyNormalized\": null,\n        \"deactivateIds\": [],\n        \"activateIds\": []\n      }\n    ]\n  },\n  \"hasAnonymizedContent\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                      "const body = pm.response.json();",
                      "pm.test('panel id exists', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });",
                      "pm.collectionVariables.set('anonymizedPanelId', body.id);",
                      "pm.environment.set('anonymizedPanelId', body.id);"
                    ]
                  }
                }
              ]
