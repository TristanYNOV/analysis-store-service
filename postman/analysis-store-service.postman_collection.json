                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Timeline joueurs anonymisée\",\n  \"description\": \"Occurrences liées à des éléments anonymisables\",\n  \"contentJson\": {\n    \"schemaVersion\": \"1.0.0\",\n    \"type\": \"analysis-timeline\",\n    \"timelineName\": \"Timeline joueurs - anonymisation\",\n    \"meta\": {\n      \"createdAtIso\": \"2026-04-11T09:05:00Z\",\n      \"updatedAtIso\": \"2026-04-11T09:35:00Z\",\n      \"exportedAtIso\": \"2026-04-11T10:05:00Z\",\n      \"sourceUserId\": null,\n      \"sourceApp\": \"analysis-store-service\",\n      \"sourceAppVersion\": \"1.0.0\"\n    },\n    \"eventDefs\": [\n      {\n        \"id\": \"evt-player-01\",\n        \"name\": \"Action joueur: Alex Martin\",\n        \"colorHex\": \"#E63946\",\n        \"isAnonymized\": true\n      },\n      {\n        \"id\": \"evt-tech-01\",\n        \"name\": \"Transition défensive\",\n        \"colorHex\": \"#2A9D8F\"\n      }\n    ],\n    \"labelDefs\": [\n      {\n        \"id\": \"lbl-zone-01\",\n        \"name\": \"Zone côté gauche\",\n        \"colorHex\": \"#264653\"\n      },\n      {\n        \"id\": \"lbl-player-01\",\n        \"name\": \"Joueur ciblé: Alex Martin\",\n        \"colorHex\": \"#457B9D\",\n        \"anonymized\": true\n      }\n    ],\n    \"occurrences\": [\n      {\n        \"id\": \"occ-0001\",\n        \"eventDefId\": \"evt-player-01\",\n        \"labelDefId\": \"lbl-player-01\",\n        \"occurredAtIso\": \"2026-04-11T09:10:00+00:00\",\n        \"durationMs\": 2500,\n        \"note\": \"Alex Martin réalise une passe en profondeur\"\n      },\n      {\n        \"id\": \"occ-0002\",\n        \"eventDefId\": \"evt-tech-01\",\n        \"labelDefId\": \"lbl-zone-01\",\n        \"occurredAtIso\": \"2026-04-11T09:13:00+00:00\",\n        \"durationMs\": 1800,\n        \"note\": \"Bloc équipe bien positionné\"\n      }\n    ],\n    \"ui\": {\n      \"zoom\": 1,\n      \"showLabels\": true,\n      \"selectedOccurrenceId\": \"occ-0001\"\n    }\n  },\n  \"hasAnonymizedContent\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                      "const body = pm.response.json();",
                      "pm.test('timeline id exists', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });",
                      "pm.collectionVariables.set('anonymizedTimelineId', body.id);",
                      "pm.environment.set('anonymizedTimelineId', body.id);"
                    ]
                  }
                }
              ]
