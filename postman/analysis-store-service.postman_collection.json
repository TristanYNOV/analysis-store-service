              "raw": "{\n  \"schemaVersion\": \"1.0.0\",\n  \"type\": \"sequencer-panel\",\n  \"panelName\": \"Match Control Panel\",\n  \"meta\": {\n    \"createdAtIso\": \"2026-04-04T08:00:00Z\",\n    \"updatedAtIso\": \"2026-04-04T08:30:00Z\",\n    \"exportedAtIso\": \"2026-04-04T09:00:00+00:00\",\n    \"sourceUserId\": \"user-42\",\n    \"sourceApp\": \"analysis-store-service\",\n    \"sourceAppVersion\": \"1.0.0\"\n  },\n  \"btnList\": [\n    {\n      \"id\": \"btn-event-goal\",\n      \"name\": \"Goal Event\",\n      \"type\": \"event\",\n      \"eventProps\": {\n        \"eventName\": \"Goal\",\n        \"colorHex\": \"#00FFAA\"\n      },\n      \"layout\": {\n        \"x\": 0,\n        \"y\": 0,\n        \"w\": 2,\n        \"h\": 1,\n        \"z\": 0\n      },\n      \"hotkeyNormalized\": \"Ctrl+G\",\n      \"deactivateIds\": [],\n      \"activateIds\": [\n        \"btn-stat-possession\"\n      ]\n    },\n    {\n      \"id\": \"btn-label-phase1\",\n      \"name\": \"Phase 1\",\n      \"type\": \"label\",\n      \"labelProps\": {\n        \"label\": \"Build-up\",\n        \"colorHex\": \"#112233\"\n      },\n      \"layout\": {\n        \"x\": 2,\n        \"y\": 0,\n        \"w\": 2,\n        \"h\": 1,\n        \"z\": 1\n      },\n      \"hotkeyNormalized\": null,\n      \"deactivateIds\": [\n        \"btn-event-goal\"\n      ],\n      \"activateIds\": []\n    },\n    {\n      \"id\": \"btn-stat-possession\",\n      \"name\": \"Possession\",\n      \"type\": \"stat\",\n      \"stat\": {\n        \"statName\": \"possession\",\n        \"value\": 56,\n        \"colorHex\": \"#445566\"\n      },\n      \"layout\": {\n        \"x\": 4,\n        \"y\": 0,\n        \"w\": 2,\n        \"h\": 1,\n        \"z\": 2\n      },\n      \"hotkeyNormalized\": null,\n      \"deactivateIds\": [],\n      \"activateIds\": []\n    }\n  ]\n}"
            },
