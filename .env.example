# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server port
PORT=3001

# Required in development/production (optional in test)
DATABASE_URL=postgres://analysis_store:analysis_store@localhost:5432/analysis_store

# Optional database name override
DB_NAME=analysis_store

# Required in development/production (optional in test)
MASTER_KEY=change-me-in-local-dev

# Required in development/production (optional in test)
CRYPTO_KEY_VERSION=v1

# RabbitMQ domain events
# Host/local Node.js default. Docker Compose overrides this to rabbitmq:5672 inside the container network.
RABBITMQ_URL=amqp://app:change_me@localhost:5673
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE_ANALYSIS_STORE=analysis-store-service.user-deletion

# Local Docker host ports. Defaults avoid conflicts with auth-service local RabbitMQ on 5672/15672.
RABBITMQ_AMQP_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
